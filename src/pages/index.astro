    <title>Rahul Ranjan | AI, Radar Signals & Mobile Health</title>
    <link rel="icon" href="data:," />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,300;1,9..144,400&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-accent focus:text-white focus:rounded-lg"
    >
      Skip to main content
    </a>

    <!-- Scroll progress bar -->
    <div class="fixed top-0 left-0 w-full h-[2px] bg-border/20 z-50">
      <div id="scroll-progress-bar" class="h-full bg-gradient-to-r from-accent via-accent-light to-accent transition-all duration-150 ease-out" style="width:0%"></div>
    </div>

    <!-- Back to top -->
    <button
      id="back-to-top"
      class="hidden fixed bottom-6 right-6 z-40 p-3 bg-accent text-white rounded-full shadow-lg hover:bg-accent/90 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40 focus-visible:ring-offset-2"
      aria-label="Back to top"
      style="box-shadow: 0 8px 24px rgba(15,118,110,0.35);"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18" />
      </svg>
    </button>

    <!-- Navigation -->
    <nav aria-label="Primary" class="fixed top-3 left-3 right-3 z-50 mx-auto max-w-6xl bg-surface/90 backdrop-blur-xl border border-border/50 rounded-2xl px-2.5 py-1.5" style="box-shadow: 0 8px 32px rgba(20,18,16,0.10), 0 1px 0 rgba(255,255,255,0.6) inset;">
      <div class="flex items-center gap-2">
        <ul class="flex-1 min-w-0 flex items-center gap-1 md:gap-1.5 overflow-x-auto hide-scrollbar px-1">
          {navItems.map((item, idx) => (
            <li>
              <a
                href={`#${item.id}`}
                data-nav-link
                data-target={item.id}
                aria-current={idx === 0 ? 'page' : undefined}
                class={`inline-flex items-center gap-1.5 whitespace-nowrap px-3 py-1.5 rounded-full text-[11px] md:text-xs font-semibold transition-all duration-200 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40 focus-visible:ring-offset-2 ${idx === 0 ? 'bg-accent text-white shadow-[0_6px_16px_rgba(15,118,110,0.32)]' : 'text-secondary hover:bg-accent/10 hover:text-primary'}`}
              >
                <span class={`h-1.5 w-1.5 rounded-full flex-shrink-0 ${idx === 0 ? 'bg-white/80' : 'bg-secondary/30'}`} aria-hidden="true"></span>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
        {content.profile.contacts.cv && (
          <a
            href={content.profile.contacts.cv}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-shimmer px-3 py-1.5 rounded-full text-[11px] md:text-xs font-semibold bg-primary text-white hover:bg-primary/90 transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40 focus-visible:ring-offset-2 flex-shrink-0"
            style="box-shadow: 0 6px 16px rgba(20,18,16,0.22);"
          >
            Résumé ↗
          </a>
        )}
      </div>
    </nav>

    <main id="main-content" class="min-h-screen text-text">
      <!-- Hero Section -->
      <div id="hero">
        <section class="relative min-h-[68vh] lg:min-h-[74vh] overflow-hidden">
          <!-- Background orbs – multi-colour -->
          <div class="absolute -top-40 -right-40 h-[520px] w-[520px] rounded-full blur-3xl motion-safe:animate-float-slow" style="background: radial-gradient(circle, rgba(124,58,237,0.12) 0%, rgba(15,118,110,0.08) 50%, transparent 70%);"></div>
          <div class="absolute -bottom-40 -left-24 h-[400px] w-[400px] rounded-full blur-3xl motion-safe:animate-float-medium" style="background: radial-gradient(circle, rgba(2,132,199,0.11) 0%, rgba(15,118,110,0.07) 55%, transparent 70%);"></div>
          <div class="absolute top-[30%] left-[30%] h-[280px] w-[480px] rounded-full blur-3xl opacity-40" style="background: radial-gradient(ellipse, rgba(217,119,6,0.07) 0%, rgba(225,29,72,0.04) 50%, transparent 70%);"></div>

          <div class="max-w-6xl mx-auto px-3 sm:px-5 lg:px-6 pt-24 pb-4 grid items-center gap-8 lg:gap-10 lg:grid-cols-[1fr_1.1fr]">
            <!-- Left: Text content -->
            <div class="space-y-5 text-center lg:text-left">
              <div class="inline-flex items-center gap-2 justify-center lg:justify-start">
                <span class="section-label">Research Portfolio</span>
              </div>

              <div class="space-y-2">
                <h1 class="text-5xl md:text-[3.75rem] lg:text-[4.5rem] xl:text-[5rem] font-semibold text-primary leading-[0.92] tracking-tight motion-safe:animate-fade-up">
                  {content.profile.name}
                </h1>
                <p class="text-xl md:text-2xl text-secondary font-medium motion-safe:animate-fade-up-slow motion-safe:[animation-delay:100ms]">
                  {content.profile.title}
                </p>
              </div>

              <div class="text-sm md:text-base text-secondary/75 space-y-0.5 motion-safe:animate-fade-up-slow motion-safe:[animation-delay:180ms]">
                <p>{content.profile.affiliationLine1}</p>
                <p class="font-medium text-secondary/90">{content.profile.affiliationLine2}</p>
              </div>

              <!-- Quick facts -->
              {content.profile.quickFacts?.length > 0 && (
                <div class="grid gap-2.5 sm:grid-cols-3 pt-2 motion-safe:animate-fade-up-slow motion-safe:[animation-delay:260ms]">
                  {content.profile.quickFacts.map((fact, fi) => (
                    <div class={`stat-card rounded-2xl border border-border/60 bg-surface/85 px-4 py-4 text-left backdrop-blur-sm`} style="box-shadow: 0 8px 20px rgba(20,18,16,0.07); padding-top: 1.25rem;">
                      <p class="text-[10px] uppercase tracking-[0.22em] text-secondary/55 mb-1">{fact.label}</p>
                      <p class="text-base font-semibold text-primary leading-tight">{fact.value}</p>
                      {fact.detail && <p class="text-xs text-secondary/65 mt-0.5">{fact.detail}</p>}
                    </div>
                  ))}
                </div>
              )}

              <!-- CTAs -->
              <div class="flex flex-wrap gap-2.5 justify-center lg:justify-start pt-1 motion-safe:animate-fade-up-slow motion-safe:[animation-delay:340ms]">
                <a
                  href={`mailto:${content.profile.contacts.email}`}
                  class="btn-shimmer inline-flex items-center gap-2 px-5 py-2.5 text-sm bg-accent text-white font-semibold rounded-full hover:bg-accent/90 transition-all duration-200 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40 focus-visible:ring-offset-2"
                  style="box-shadow: 0 10px 28px rgba(15,118,110,0.28);"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                  Contact Me
                </a>
                {content.profile.contacts.cv && (
                  <a
                    href={content.profile.contacts.cv}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-shimmer inline-flex items-center gap-2 px-5 py-2.5 text-sm bg-primary text-white font-semibold rounded-full hover:bg-primary/90 transition-all duration-200 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40 focus-visible:ring-offset-2"
                    style="box-shadow: 0 10px 28px rgba(20,18,16,0.20);"
                  >
                    Résumé ↗
                  </a>
                )}
                <a
                  href={content.profile.contacts.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-5 py-2.5 text-sm border border-primary/20 text-primary font-semibold rounded-full hover:bg-primary hover:text-white transition-all duration-200 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40 focus-visible:ring-offset-2"
                >
                  <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                  LinkedIn
                </a>
                <a
                  href={content.profile.contacts.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-5 py-2.5 text-sm border border-primary/20 text-primary font-semibold rounded-full hover:bg-primary hover:text-white transition-all duration-200 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40 focus-visible:ring-offset-2"
                >
                  <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
                  GitHub
                </a>
                {content.profile.contacts.scholar && (
                  <a
                    href={content.profile.contacts.scholar}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 px-5 py-2.5 text-sm border border-accent/35 text-accent font-semibold rounded-full hover:bg-accent hover:text-white transition-all duration-200 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40 focus-visible:ring-offset-2"
                  >
                    <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z"/></svg>
                    Scholar
                  </a>
                )}
              </div>
            </div>

            <!-- Right: Profile card -->
            <div class="relative lg:justify-self-end w-full max-w-xl self-stretch">
              <div class="relative rounded-3xl p-5 md:p-6 h-full flex flex-col gap-5 backdrop-blur-sm" style="background: rgba(255,251,244,0.92); border: 1px solid rgba(228,221,209,0.7); box-shadow: 0 20px 50px rgba(20,18,16,0.13), 0 1px 0 rgba(255,255,255,0.7) inset;">

                <!-- Profile header -->
                <div class="relative rounded-2xl p-4" style="background: linear-gradient(135deg, rgba(15,118,110,0.06), rgba(15,118,110,0.02)); border: 1px dashed rgba(15,118,110,0.2);">
                  <!-- Subtle grid dots -->
                  <div class="absolute inset-0 rounded-2xl opacity-40" style="background-image: radial-gradient(rgba(20,18,16,0.06) 1px, transparent 1px); background-size: 16px 16px;"></div>
                  <div class="relative flex items-center gap-5">
                    <div class="w-[100px] h-[100px] sm:w-[110px] sm:h-[110px] rounded-full overflow-hidden flex-shrink-0" style="border: 2.5px solid rgba(228,221,209,0.9); box-shadow: 0 8px 20px rgba(20,18,16,0.12);">
                      <img src={content.profile.portrait} alt={`Portrait of ${content.profile.name}`} width="800" height="828" class="w-full h-full object-cover" />
                    </div>
                    <div>
                      <p class="text-[10px] uppercase tracking-[0.28em] text-secondary/55 mb-1.5">Research Snapshot</p>
                      <p class="text-xl font-semibold text-primary leading-tight">Radar AI +<br/>Mobile Health</p>
                      <p class="text-sm text-secondary/65 mt-1">Signal reconstruction and clinical sensing</p>
                    </div>
                  </div>
                </div>

                <!-- Highlights -->
                {content.about.highlights?.length > 0 && (
                  <ul class="grid gap-2.5">
                    {content.about.highlights.map((item) => (
                      <li class="flex items-start gap-3 rounded-xl px-4 py-3 text-sm text-secondary/85" style="background: rgba(242,237,228,0.7); border: 1px solid rgba(228,221,209,0.6);">
                        <span class="mt-1 inline-flex h-1.5 w-1.5 rounded-full bg-accent flex-shrink-0" aria-hidden="true"></span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          </div>
        </section>
      </div>

      <!-- Divider -->
      <div class="section-divider mx-auto max-w-6xl"></div>

      <!-- About Section -->
      <section id="about" class="pt-10 pb-12 md:pt-12 md:pb-14 px-3 sm:px-5 lg:px-6 bg-surface">
        <div class="max-w-6xl mx-auto">
          <div class="mb-6 reveal">
            <p class="section-label">Background</p>
            <h2 class="text-2xl md:text-3xl font-semibold text-primary">About & Contact</h2>
          </div>

          <div class="space-y-3 mb-6 reveal">
            {(Array.isArray(content.about.blurb) ? content.about.blurb : [content.about.blurb]).map((paragraph, i) => (
              <p class={`leading-relaxed ${i === 0 ? 'text-lg md:text-xl text-primary/90 font-medium' : 'text-base md:text-lg text-secondary/85'}`}>{paragraph}</p>
            ))}
          </div>

          {content.about.highlights?.length > 0 && (
            <div class="flex flex-wrap gap-2 mb-8 reveal">
              {content.about.highlights.map((highlight, hi) => (
                <span class={`highlight-tag px-3.5 py-1.5 rounded-full text-xs font-semibold border`}>{highlight}</span>
              ))}
            </div>
          )}

          <!-- Recent Updates -->
          {content.about.updates?.length > 0 && (
            <div class="rounded-2xl p-4 md:p-5 mb-6 reveal" style="background: rgba(242,237,228,0.65); border: 1px solid rgba(228,221,209,0.8); box-shadow: 0 4px 12px rgba(20,18,16,0.05);">
              <h3 class="text-lg font-semibold text-primary mb-4 flex items-center gap-2">
                <span class="inline-flex items-center justify-center w-6 h-6 rounded-full text-white text-[10px]" style="background: linear-gradient(135deg,#0f766e,#7c3aed);">✦</span>
                Recent Updates
              </h3>
              <ul class="space-y-3.5">
                {content.about.updates.map((update, ui) => {
                  const dotColors = ['#0f766e','#7c3aed','#0369a1','#d97706'];
                  const dc = dotColors[ui % dotColors.length];
                  return (
                    <li class="flex flex-col sm:flex-row sm:items-start gap-2">
                      <span class="font-semibold text-sm sm:min-w-[148px] flex-shrink-0" style={`color: ${dc};`}>{update.date}</span>
                      <span class="text-secondary/85 text-sm leading-relaxed">{update.text}</span>
                    </li>
                  );
                })}
              </ul>
            </div>
          )}

          <!-- Tech Stack -->
          {content.about.techStack?.length > 0 && (
            <div class="rounded-2xl p-4 md:p-5 mb-6 reveal" style="background: rgba(255,251,244,0.9); border: 1px solid rgba(228,221,209,0.8); box-shadow: 0 4px 12px rgba(20,18,16,0.05);">
              <h3 class="text-lg font-semibold text-primary mb-4">Technical Skills</h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                {content.about.techStack.map((group, gi) => {
                  const groupColors = [
                    { border: 'rgba(15,118,110,0.18)', label: '#0f766e', bg: 'rgba(15,118,110,0.05)' },
                    { border: 'rgba(124,58,237,0.18)', label: '#7c3aed', bg: 'rgba(124,58,237,0.05)' },
                    { border: 'rgba(225,29,72,0.15)',  label: '#be123c', bg: 'rgba(225,29,72,0.04)' },
                    { border: 'rgba(217,119,6,0.18)',  label: '#b45309', bg: 'rgba(217,119,6,0.05)' },
                    { border: 'rgba(2,132,199,0.18)',  label: '#0369a1', bg: 'rgba(2,132,199,0.05)' },
                    { border: 'rgba(162,28,175,0.15)', label: '#86198f', bg: 'rgba(162,28,175,0.04)' },
                  ];
                  const gc = groupColors[gi % groupColors.length];
                  return (
                    <div class="rounded-xl p-3.5" style={`background: ${gc.bg}; border: 1px solid ${gc.border};`}>
                      <h4 class="text-[10px] font-semibold mb-2.5 uppercase tracking-[0.2em]" style={`color: ${gc.label};`}>{group.title}</h4>
                      <div class="flex flex-wrap gap-1.5">
                        {group.items.map((item) => <span class={`tech-tag tech-cat-${gi % 6}`}>{item}</span>)}
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          )}

          <!-- Contact -->
          <div class="rounded-2xl p-4 md:p-5 mb-6 reveal" style="background: linear-gradient(135deg, rgba(15,118,110,0.08) 0%, rgba(242,237,228,0.6) 100%); border: 1px solid rgba(15,118,110,0.18);">
            <h3 class="text-lg font-semibold text-primary mb-3">Contact</h3>
            <div class="grid sm:grid-cols-2 gap-2 text-sm text-secondary/85">
              <p class="flex items-center gap-2">
                <svg class="w-4 h-4 text-accent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                <a href={`mailto:${content.profile.contacts.email}`} class="text-accent hover:text-accent/80 transition-colors">{content.profile.contacts.email}</a>
              </p>
              <p class="flex items-center gap-2">
