    <meta name="description" content="Rahul Ranjan - PhD Candidate applying machine learning and deep learning to radar signal reconstruction, signal cleaning, and contactless mobile health sensing." />
    <meta name="keywords" content="Rahul Ranjan, radar signal reconstruction, radar denoising, deep learning, Edge AI, Mobile Health, rPPG, contactless vitals, robust signal processing, Monash University" />
